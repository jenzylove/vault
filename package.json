{
  "name": "the-vault",
  "version": "0.1.0",
  "private": true,
  "description": "A heist game where the buyer reads your breathing: crack safes, hide what you found, and sell them to The Fence. Built on the Presage SmartSpectra SDK.",
  "author": "JDollar",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win --x64",
    "preview": "electron-vite preview",
    "web": "vite build -c vite.web.config.mts",
    "web:deploy": "npm run web && node scripts/web-deploy.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "voice": "python scripts/voice/gen.py"
  },
  "overrides": {
    "@smartspectra/node-sdk-linux-x64": "file:./stubs/linux-x64",
    "@smartspectra/node-sdk-linux-arm64": "file:./stubs/linux-arm64",
    "@smartspectra/node-sdk-darwin-arm64": "file:./stubs/darwin-arm64"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0"
  },
  "devDependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "postprocessing": "^6.39.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
